@PACKAGE_INIT@

# Snowstorm engine SDK. Consume with:
#
#   find_package(Snowstorm REQUIRED)
#   target_link_libraries(MyGame PRIVATE $<LINK_LIBRARY:WHOLE_ARCHIVE,Snowstorm::Core>)
#
# WHOLE_ARCHIVE matters: Core's components self-register through static initializers, and a linker that
# drops the unreferenced translation units drops the component registry with them.
#
# Snowstorm-Core is a static library, so every dependency is part of the consumer's link line and has to
# be found again here. They all come from the same vcpkg tree the engine was built against, so configure
# the consumer with that toolchain file.

include(CMakeFindDependencyMacro)

find_dependency(assimp CONFIG)
find_dependency(EnTT CONFIG)
find_dependency(fmt CONFIG)
find_dependency(GLEW)
find_dependency(glfw3 CONFIG)
find_dependency(glm CONFIG)
find_dependency(imgui CONFIG)
find_dependency(rttr CONFIG)
find_dependency(spdlog CONFIG)
find_dependency(Stb)
find_dependency(Vulkan)
find_dependency(VulkanMemoryAllocator CONFIG)
find_dependency(gli CONFIG)
find_dependency(volk CONFIG)
find_dependency(unofficial-spirv-reflect CONFIG)
find_dependency(nlohmann_json CONFIG)
find_dependency(Tracy CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/SnowstormTargets.cmake")

# Stb is a find-module that sets a variable rather than defining an imported target, so its include
# directory cannot ride along in the exported target's INTERFACE and is attached here instead.
if(Stb_INCLUDE_DIR)
    set_property(TARGET Snowstorm::Core APPEND PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${Stb_INCLUDE_DIR}")
endif()

# The engine's own runtime files: Engine/Shaders, Engine/Fonts and Tools/dxc, installed as a tree a game
# stages beside its executable. The engine resolves these relative to the executable at runtime (see
# Snowstorm/Core/EnginePaths.hpp), so a game copies them next to its binary rather than pointing at them.
set_and_check(SNOWSTORM_ASSET_DIR "@PACKAGE_SNOWSTORM_ASSET_INSTALL_DIR@")

# Which build configurations this SDK actually carries. A multi-config generator configures all of them,
# so a consumer building a configuration the SDK was never installed for gets "IMPORTED_LOCATION not set"
# at generate time and a link failure later. Say so plainly instead. Install another configuration with
# `cmake --install <build> --config Release --prefix <prefix>`. There is deliberately no mapping of a
# missing configuration onto an available one: linking a debug CRT into a release binary is worse than
# the error.
get_target_property(_snowstorm_configs Snowstorm::Core IMPORTED_CONFIGURATIONS)
message(STATUS "Snowstorm SDK: configurations available: ${_snowstorm_configs}")
unset(_snowstorm_configs)

check_required_components(Snowstorm)
