# Directories
.vs/
.venv/
build/
Vendor/Binaries
vcpkg/
Engine/cache
# Cached PT references for the image-quality gate (per-machine, regenerated on demand). See Scripts/quality-bench.py.
Scripts/.quality-ref-cache/
Scripts/.quality-motion-tmp/
# Radeon GPU Analyzer, auto-bootstrapped (pinned version, ~238MB) by Scripts/rga-occupancy.py.
# Downloaded tool, not source: never commit.
Tools/rga/
# Radeon Developer Tool Suite (RGP/RDP/RDS), bootstrapped by Scripts/rgp-capture.py. Downloaded
# tool, not source: never commit.
Tools/rdts/

# Files
*.vcxproj
*.vcxproj.user
*.vcxproj.filters
*.sln
*.log
*.json
# Committed golden perf baselines (not generated artifacts): re-included past the blanket *.json so the
# perf-bench regression gate has a tracked reference. See Scripts/perf-bench.py.
!Scripts/perf-baseline/
!Scripts/perf-baseline/**/*.json
# Committed golden occupancy baselines for the RGA static gate. See Scripts/rga-occupancy.py.
!Scripts/rga-baseline/
!Scripts/rga-baseline/*.json
# Committed golden image-quality baselines for the FLIP/PSNR/SSIM gate. See Scripts/quality-bench.py.
!Scripts/quality-baseline/
!Scripts/quality-baseline/**/*.json
!Scripts/quality-motion-baseline/**/*.json
# Committed driver-reported shader statistics (the cross-vendor citable record, not a gate).
# See Scripts/shader-stats.py.
!Scripts/shader-stats-baseline/
!Scripts/shader-stats-baseline/*.json
*.DotSettings
*.DotSettings.user
*.ini
*.cmake
CMakeCache.txt
ALL_BUILD.*
ZERO_CHECK.*
Makefile

# Local vcpkg overlay ports and triplets are real sources and MUST be committed, despite the
# blanket *.json / *.cmake ignores above (those target generated build files).
!Scripts/vcpkg-overlays/
!Scripts/vcpkg-overlays/**
!Scripts/vcpkg-triplets/
!Scripts/vcpkg-triplets/**

# The asset registry maps the UUID handles in committed scenes to their files. It
# is project data, not build output, so it must travel with the scenes (despite
# the blanket *.json ignore) or every fresh checkout renders nothing. The demo
# content now lives in the Sandbox project, so un-ignore its registry there.
!Projects/Sandbox/assets/AssetRegistry.json

# Authored benchmark camera routes. Committed data, not build output: a missing route file makes the engine
# fall back to the circular orbit, which still runs, so the failure would show up as quietly wrong numbers
# rather than as an error.
!Projects/Sandbox/assets/camera-paths/
!Projects/Sandbox/assets/camera-paths/**/*.json

# Editor fonts are shipped assets (the NERV theme loads a monospace TTF from here).
!Engine/Fonts/
!Engine/Fonts/**
# Local user settings written by the editor on shutdown (persistent CVars). Machine-local
# state, not project data: must not be committed.
SnowstormConfig.cfg
# Hand-authored startup CVar overrides (dev/machine toggles like validation.extra); read at startup,
# never written by the app. Machine-local, must not be committed.
SnowstormStartup.cfg

# Neural training harness (#99): generated artifacts. Scripts under Tools/neural/ are tracked; the
# captured datasets, trained weights, and Python caches are large/generated and must not be committed.
Dataset/
*.ssnn
*.npy
__pycache__/
.pytest_cache/

# Doom IWADs (doom.wad, freedoom1.wad, ...) for the optional SS_ENABLE_DOOM build. Game data, not
# engine source: the commercial ones cannot be redistributed at all, and even the freely licensed
# ones are large binaries that belong next to the build, not in this history.
*.wad
*.WAD
# doomgeneric writes its config and savegames to the working directory, which for the editor is the
# repo root, and this fork hardcodes that (GetDefaultConfigDir returns "."), so there is no flag to
# redirect it.
.default.cfg
.savegame/

# Local scratch: investigation logs, ad-hoc drivers, saved diffs. Never part of a build.
/_t1/
/_scratch/
/*.patch
/*.diff
/_*.txt
